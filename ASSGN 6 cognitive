    "## Q2. Daily Steps\n",
    "Four users' step counts over three days."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5835f225",
   "metadata": {},
   "outputs": [],
   "source": [
    "steps = np.array([\n",
    "    [5000, 6200, 7100],\n",
    "    [8000, 7500, 9000],\n",
    "    [4500, 5100, 4800],\n",
    "    [9000, 8500, 9500]\n",
    "])\n",
    "\n",
    "# a. Total steps recorded\n",
    "total_steps = np.sum(steps)\n",
    "print(\"Total steps:\", total_steps)\n",
    "\n",
    "# b. Mean number of steps\n",
    "mean_steps = np.mean(steps)\n",
    "print(\"Mean steps:\", mean_steps)\n",
    "\n",
    "# c. Maximum and minimum values\n",
    "print(\"Maximum steps:\", np.max(steps))\n",
    "print(\"Minimum steps:\", np.min(steps))\n",
    "\n",
    "# d. Total steps for each day (axis=0)\n",
    "daily_totals = np.sum(steps, axis=0)\n",
    "print(\"Total steps for each day:\", daily_totals)\n",
    "\n",
    "# e. Total steps for each user (axis=1)\n",
    "user_totals = np.sum(steps, axis=1)\n",
    "print(\"Total steps for each user:\", user_totals)\n",
    "\n",
    "# f. Position containing the maximum number of steps\n",
    "max_position = np.unravel_index(np.argmax(steps), steps.shape)\n",
    "print(\"Position of maximum steps (user index, day index):\", max_position)\n",
    "print(\"Maximum value:\", steps[max_position])"
   ]
  },
