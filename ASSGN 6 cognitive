    "## Q3. NumPy Arrays, Slicing, Copying, Flattening and Raveling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "14a96c0d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# a. Create the original array\n",
    "original = np.array([1, 2, 3, 4, 5, 6])\n",
    "print(\"Original:\", original)\n",
    "\n",
    "# b. Slice from index 1 to 4 (index 4 excluded)\n",
    "subset = original[1:4]\n",
    "print(\"Subset:\", subset)\n",
    "\n",
    "# c. Modify first element of subset\n",
    "subset[0] = 999\n",
    "print(\"\\nAfter modifying subset:\")\n",
    "print(\"Original:\", original)\n",
    "print(\"Subset:\", subset)\n",
    "\n",
    "# d. Create another slice using copy()\n",
    "copied = original[1:4].copy()\n",
    "copied[0] = 500\n",
    "print(\"\\nAfter modifying copied array:\")\n",
    "print(\"Original:\", original)\n",
    "print(\"Copied array:\", copied)\n",
    "\n",
    "# e. Create numbers 1 to 12 and reshape into 3 x 4\n",
    "matrix = np.arange(1, 13).reshape(3, 4)\n",
    "print(\"\\n3 x 4 matrix:\")\n",
    "print(matrix)\n",
    "\n",
    "# f. NumPy indexing and slicing\n",
    "print(\"\\nFirst row:\", matrix[0])\n",
    "print(\"Last row:\", matrix[-1])\n",
    "print(\"Second column:\", matrix[:, 1])\n",
    "print(\"Rows 1–2 and columns 2–3:\")\n",
    "print(matrix[1:3, 2:4])\n",
    "\n",
    "# g. Flatten using flatten() and ravel()\n",
    "flat_array = matrix.flatten()\n",
    "ravel_array = matrix.ravel()\n",
    "print(\"\\nUsing flatten():\", flat_array)\n",
    "print(\"Using ravel():\", ravel_array)\n",
    "\n",
    "# h. Modify ravel() result\n",
    "ravel_array[0] = 100\n",
    "print(\"\\nAfter modifying ravel()[0] to 100:\")\n",
    "print(\"Ravel array:\", ravel_array)\n",
    "print(\"Original matrix:\")\n",
    "print(matrix)\n",
    "\n",
    "# i. Modify flatten() result\n",
    "flat_array[1] = 200\n",
    "print(\"\\nAfter modifying flatten()[1] to 200:\")\n",
    "print(\"Flatten array:\", flat_array)\n",
    "print(\"Original matrix:\")\n",
    "print(matrix)\n",
    "\n",
    "# j. Display shape, ndim, size and dtype\n",
    "print(\"\\nShape:\", matrix.shape)\n",
    "print(\"Dimensions (ndim):\", matrix.ndim)\n",
    "print(\"Size:\", matrix.size)\n",
    "print(\"Data type (dtype):\", matrix.dtype)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9550fd25",
   "metadata": {},
   "source": [
    "### Q3 observations\n",
    "- A normal NumPy slice such as `original[1:4]` is a **view**, so changing the slice can also change the original array.\n",
    "- `.copy()` creates an independent copy, so changing it does not change the original.\n",
    "- `ravel()` normally returns a **view** when possible, so modifying it can affect the original array.\n",
    "- `flatten()` always returns a **copy**, so modifying it does not affect the original array."
   ]
  },
